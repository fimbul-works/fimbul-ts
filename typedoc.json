{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "outputs": [
    {
      "name": "markdown",
      "path": "./docs"
    }
  ],
  "entryFileName": "API.md",
  "plugin": ["typedoc-plugin-markdown"],
  "gitRevision": "main",
  "outputFileStrategy": "modules",
  "useCodeBlocks": true,
  "expandObjects": true,
  "navigationModel": {
    "excludeGroups": true,
    "excludeCategories": true
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true,
    "includeFolders": true
  },
  "flattenOutputFiles": true,
  "hidePageTitle": false,
  "hideBreadcrumbs": false,
  "hidePageHeader": true,
  "readme": "none",
  "cleanOutputDir": true,
  "indexFormat": "table",
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "disableSources": true,
  "name": "[![@fimbul-works/fimbul](../fimbul-logo.svg)](https://www.npmjs.com/package/@fimbul-works/fimbul)"
}
