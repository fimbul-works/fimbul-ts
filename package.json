{
  "name": "@fimbul-works/fimbul",
  "description": "A lightweight, type-safe computation graph engine with automatic topological resolution and built-in caching",
  "version": "3.0.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/fimbul-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/fimbul-ts.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/fimbul-ts/issues"
  },
  "keywords": [
    "computation-graph",
    "dag",
    "directed-graph",
    "graph",
    "dependency-resolution",
    "dependency-management",
    "topological-sort",
    "computation",
    "functional",
    "procedural-generation",
    "procgen",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "clean:bundles": "rm -rf bundles",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs && pnpm build:docs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:bundles": "pnpm clean:bundles && NODE_OPTIONS='--max-old-space-size=4096' tsdown",
    "build:all": "pnpm build && pnpm build:bundles && pnpm sizes",
    "build:docs": "typedoc",
    "format": "npx biome format --write",
    "test": "vitest",
    "sizes": "npx bundle-size",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fimbul-works/bundle-size": "^2.0.0",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
