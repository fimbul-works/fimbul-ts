{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!**/dist", "!!**/node_modules", "!!**/bundles"]
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": { "noCommaOperator": "off" },
      "suspicious": { "useIterableCallbackReturn": "off", "noAssignInExpressions": "off", "noExplicitAny": "off" }
    }
  }
}
